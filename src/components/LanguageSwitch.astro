---
import { otherLocale, useTranslations, type Locale } from '@/i18n';
import { pagePath, stripLocale } from '@/lib/urls';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const target = otherLocale(lang);
// Todas las páginas existen en ambos idiomas (las entradas sin traducir usan la versión disponible).
const href = pagePath(target, stripLocale(Astro.url.pathname));
---

<a class="lang-switch" href={href} hreflang={target} lang={target} aria-label={t.a11y.switchLanguage}>
  {t.lang.other}
</a>

<style>
  .lang-switch {
    display: grid;
    place-items: center;
    min-width: 44px;
    height: 44px;
    padding-inline: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .lang-switch:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
</style>
