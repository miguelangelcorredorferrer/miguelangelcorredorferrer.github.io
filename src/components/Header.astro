---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { useTranslations, type Locale } from '@/i18n';
import { pagePath, stripLocale } from '@/lib/urls';
import { cvHref, profile } from '@/lib/data';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const section = stripLocale(Astro.url.pathname).split('/')[0] ?? '';

const links = [
  { key: 'projects', label: t.nav.projects },
  { key: 'writeups', label: t.nav.writeups },
  { key: 'about', label: t.nav.about },
  { key: 'certifications', label: t.nav.certifications },
] as const;

const cv = cvHref(lang);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={pagePath(lang)} aria-current={section === '' ? 'page' : undefined}>
      <span class="prompt" aria-hidden="true">~$</span>
      <span>{profile.shortName ?? profile.name}</span>
    </a>

    <nav class="nav-desktop" aria-label={t.a11y.mainNav}>
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={pagePath(lang, l.key)} aria-current={section === l.key ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="btn btn-sm cv-desktop" href={cv.href} hreflang={cv.lang} download>
        <Icon name="download" size={14} />
        {t.nav.downloadCv}
      </a>
      <LanguageSwitch lang={lang} />
      <ThemeToggle lang={lang} />

      <details class="nav-mobile">
        <summary>
          <Icon name="menu" size={20} />
          <span class="visually-hidden">{t.a11y.menu}</span>
        </summary>
        <nav aria-label={t.a11y.mainNav}>
          <ul role="list">
            {
              links.map((l) => (
                <li>
                  <a href={pagePath(lang, l.key)} aria-current={section === l.key ? 'page' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="btn btn-sm" href={cv.href} hreflang={cv.lang} download>
                <Icon name="download" size={14} />
                {t.nav.downloadCv}
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-right: auto;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .prompt {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
  }

  .nav-desktop ul {
    display: flex;
    gap: var(--space-1);
  }

  nav a:not(.btn) {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  nav a:not(.btn):hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: 0;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Menú móvil: <details> funciona sin JavaScript. */
  .nav-mobile {
    position: relative;
  }

  .nav-mobile summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    list-style: none;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile[open] summary {
    border-color: var(--accent);
  }

  .nav-mobile nav {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    z-index: 50;
    min-width: 220px;
    padding: var(--space-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-hover);
  }

  .nav-mobile li + li {
    margin-top: var(--space-1);
  }

  .nav-mobile nav a[aria-current='page'] {
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .nav-mobile .btn {
    margin: var(--space-2) var(--space-3) var(--space-1);
  }

  @media (min-width: 960px) {
    .nav-mobile {
      display: none;
    }
  }

  @media (max-width: 959.98px) {
    .nav-desktop,
    .cv-desktop {
      display: none;
    }
  }
</style>
