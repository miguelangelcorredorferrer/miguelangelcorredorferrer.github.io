---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import FilterForm from '@/components/FilterForm.astro';
import { localeStaticPaths, useTranslations, type Locale } from '@/i18n';
import { filterKey, getProjects, uniqueSorted } from '@/lib/content';
import { PROJECT_CATEGORIES } from '@/content/schemas';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const projects = await getProjects(lang);

const usedCategories = PROJECT_CATEGORIES.filter((c) => projects.some((p) => p.entry.data.category === c));
const tags = uniqueSorted(projects.flatMap((p) => p.entry.data.tags));
---

<BaseLayout lang={lang} title={t.projects.title} description={t.projects.intro}>
  <header class="page-header">
    <p class="eyebrow" aria-hidden="true">~/projects</p>
    <h1>{t.projects.title}</h1>
    <p class="lead">{t.projects.intro}</p>
  </header>

  {
    projects.length ? (
      <>
        <FilterForm
          lang={lang}
          target="project-list"
          filters={[
            {
              key: 'category',
              label: t.filters.category,
              options: usedCategories.map((c) => ({ value: c, label: t.projects.categories[c] })),
            },
            {
              key: 'tag',
              label: t.filters.tag,
              options: tags.map((tag) => ({ value: filterKey(tag), label: tag })),
            },
          ]}
        />
        <ul id="project-list" class="card-grid" role="list">
          {projects.map((item) => (
            <ProjectCard item={item} lang={lang} headingLevel="h2" />
          ))}
        </ul>
      </>
    ) : (
      <p class="muted">{t.home.emptyProjects}</p>
    )
  }
</BaseLayout>
