---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Timeline from '@/components/Timeline.astro';
import SkillsGrid from '@/components/SkillsGrid.astro';
import { localeStaticPaths, pick, useTranslations, type Locale } from '@/i18n';
import { profile, timeline } from '@/lib/data';

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const intro = pick(profile.about, lang);
---

<BaseLayout lang={lang} title={t.about.title} description={intro}>
  <header class="page-header">
    <p class="eyebrow" aria-hidden="true">~/about</p>
    <h1>{t.about.title}</h1>
    <p class="lead">{intro}</p>
  </header>

  {
    timeline.experience.length > 0 && (
      <section class="section" aria-labelledby="exp-title">
        <h2 id="exp-title" class="section-title">{t.about.experience}</h2>
        <Timeline entries={timeline.experience} lang={lang} />
      </section>
    )
  }

  {
    timeline.education.length > 0 && (
      <section class="section" aria-labelledby="edu-title">
        <h2 id="edu-title" class="section-title">{t.about.education}</h2>
        <Timeline entries={timeline.education} lang={lang} />
      </section>
    )
  }

  <section class="section" aria-labelledby="stack-title">
    <h2 id="stack-title" class="section-title">{t.about.stack}</h2>
    <SkillsGrid lang={lang} />
  </section>
</BaseLayout>

<style>
  .section + .section {
    margin-top: var(--space-8);
  }

  .section-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-5);
  }

</style>
